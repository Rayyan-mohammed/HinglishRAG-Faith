GROQ_API_KEY=your_groq_api_key_here

# Optional: additional keys from separate accounts, used as automatic failover when one
# key hits Groq's daily quota during a long batch run (see judge() in src/verification.py
# and P-008 in docs/problems_and_decisions.md). Safe to leave unset -- only non-empty ones
# are used.
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=

# Anthropic (Claude) key -- used instead of Groq for generation/decomposition/verification,
# switched to in ADR-021 to get out from under Groq's 200k-tokens/day free-tier ceiling, which
# repeatedly paused full evaluation runs across several days (see docs/problems_and_decisions.md).
ANTHROPIC_API_KEY=your_anthropic_api_key_here
